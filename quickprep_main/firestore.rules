rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@quickprep\\.admin$') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Dynamic Remote Monetization & System Config
    // Public read for client app runtime, write only by authenticated admins
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories & Questions Bank
    // Public read for study materials, write only by authenticated admins
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Push Broadcasts & Announcements (e.g. Question of the day)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Feedback / Typo Reports
    // Any user can submit a report; only admins can list, review, and resolve
    match /flagged_questions/{reportId} {
      allow create: if request.resource.data.question_id is string
                    && request.resource.data.issue_type is string;
      allow read, update, delete: if isAdmin();
    }

    // User Profile, Streaks & Pro Entitlement
    // Owner has read/write access to their own data; Admins have read access
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
      
      // User Leitner spaced-repetition progress
      match /leitner_box/{questionId} {
        allow read, write: if isOwner(userId);
      }
      
      // User mock test results history
      match /quiz_history/{quizId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Admin whitelist collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed via Firebase Console or Admin SDK
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
